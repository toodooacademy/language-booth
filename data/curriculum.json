        "lines": [
          {
            "text": "すみません、お茶をお願いします。",
            "meaning": "Excuse me, tea please.",
            "reading": "sumimasen, ocha o onegai shimasu",
            "speak": "すみません、お茶をお願いします。"
          },
          {
            "text": "はい。ほかには？",
            "meaning": "Yes. Anything else?",
            "reading": "hai. hoka ni wa?",
            "speak": "はい。ほかには？"
          },
          {
            "text": "それで大丈夫です。いくらですか。",
            "meaning": "That's all. How much is it?",
            "reading": "sore de daijōbu desu. ikura desu ka",
            "speak": "それで大丈夫です。いくらですか。"
          },
          {
            "text": "三百円です。",
            "meaning": "It's 300 yen.",
            "reading": "sanbyaku en desu",
            "speak": "三百円です。"
          },
          {
            "text": "ありがとうございます。",
            "meaning": "Thank you.",
            "reading": "arigatō gozaimasu",
            "speak": "ありがとうございます。"
          }
        ]
      }
    ]
